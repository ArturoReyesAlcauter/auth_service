# ==========================================
# AUTH_SERVICE - VARIABLES DE ENTORNO
# ==========================================


# ==========================================
# APLICACIÓN
# ==========================================

PROJECT_NAME="API Central de Autenticación y Autorización"
VERSION=1.0.0
TOTP_ISSUER="Acceso Central - SNDIF"


# ==========================================
# BASE DE DATOS
# ==========================================

# Ejemplo PostgreSQL.
# Sustituir usuario, contraseña, puerto y nombre de BD según el ambiente.
DATABASE_URL=postgres://usuario:password@127.0.0.1:5432/auth_service_db


# ==========================================
# SEGURIDAD / JWT
# ==========================================

# Usar una clave larga, aleatoria y diferente en cada ambiente.
SECRET_KEY=change-me-with-a-long-random-secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Tiempo máximo de inactividad de una sesión.
SESSION_IDLE_TIMEOUT_MINUTES=60


# ==========================================
# USUARIO ADMINISTRADOR INICIAL
# ==========================================

# Contraseña utilizada exclusivamente para el SUPER_ADMIN
# creado inicialmente por el seed.
ADMIN_INITIAL_PASSWORD=change-me


# ==========================================
# USUARIOS FICTICIOS DE CRONOS
# ==========================================

# Contraseña exclusiva para las cuentas de prueba utilizadas
# para poblar el organigrama de CRONOS en desarrollo.
# No debe reutilizar la contraseña del SUPER_ADMIN.
CRONOS_TEST_PASSWORD=change-me


# ==========================================
# SSO / REDIRECCIONES AUTORIZADAS
# ==========================================

# Lista separada por comas y sin espacios entre URLs.
ALLOWED_REDIRECT_URLS=http://127.0.0.1:5173/app/dashboard,http://127.0.0.1:5173/app/formato-nna,http://127.0.0.1:5173/app/usuarios,http://127.0.0.1:5175/app/dashboard,http://127.0.0.1:5177/procuradores,http://127.0.0.1:5179/app/dashboard,http://127.0.0.1:5180/app/dashboard

REDIRECT_CODE_EXPIRE_SECONDS=60


# ==========================================
# CORREO / SMTP
# ==========================================

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=no-reply@portusderechos.gob.mx


# ==========================================
# FRONTEND
# ==========================================

FRONTEND_URL=http://localhost:5173